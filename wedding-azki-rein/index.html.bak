<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>The Wedding Of Azki & Rein · 28 November 2026</title>
<meta name="description" content="Undangan Pernikahan Azkiya Tsany Baharsyah & Reineta Dian Kusumawati — Sabtu, 28 November 2026 di Grha Saraswati Wonogiri">
<meta property="og:title" content="The Wedding Of Azki & Rein">
<meta property="og:description" content="Sabtu, 28 November 2026 · Grha Saraswati, Wonogiri">
<meta property="og:type" content="website">
<meta property="og:image" content="assets/img/azkia.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Cinzel:wght@400;500;600&family=Amiri:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400&display=swap" rel="stylesheet">
<style>
/* ── RESET ── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
img{max-width:100%;display:block}

/* ── TOKENS ── */
:root{
  --ink:#1A1410;
  --ink-soft:#2C2018;
  --parch:#F9F4EA;
  --parch-warm:#F3ECD8;
  --parch-deep:#EDE1C6;
  --gold:#B8963E;
  --gold-lt:#D4AF6A;
  --gold-dk:#8B6914;
  --gold-glow:rgba(184,150,62,.22);
  --marun:#6B2D3A;
  --forest:#1E3222;
  --forest-md:#2A4A30;
  --sage:#7A9176;
  --sage-lt:#A8B8A3;
  --muted:#7A6A55;
  --cream-line:rgba(184,150,62,.18);
  /* fluid type */
  --t-display:clamp(2.8rem,11vw,5rem);
  --t-h1:clamp(1.7rem,5.5vw,2.8rem);
  --t-body:clamp(.88rem,2.2vw,1rem);
  /* spacing */
  --sec-pad:clamp(3.5rem,8vw,5.5rem) clamp(1rem,5vw,3rem);
}

html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:'Lato',sans-serif;background:var(--parch);color:var(--ink);overflow-x:hidden;font-weight:300;line-height:1.7}

/* ── PARTICLES ── */
#pc{position:fixed;inset:0;z-index:999;pointer-events:none}

/* ════════════════════════════
   COVER
════════════════════════════ */
#cover{
  position:fixed;inset:0;z-index:1000;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;
  padding:env(safe-area-inset-top,1.5rem) clamp(1.2rem,5vw,2.5rem) env(safe-area-inset-bottom,1.5rem);
  background:linear-gradient(160deg,#0D1A10 0%,var(--forest) 35%,#3B1A22 70%,#150E08 100%);
  transition:transform 1.8s cubic-bezier(.77,0,.175,1),opacity 1.4s ease .3s,visibility 1.8s;
  overflow:hidden;
}
#cover::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse at 20% 20%,rgba(184,150,62,.06) 0%,transparent 55%),
             radial-gradient(ellipse at 80% 80%,rgba(107,45,58,.15) 0%,transparent 55%);
  pointer-events:none;
}
#cover.hidden{transform:perspective(1400px) rotateY(-110deg);opacity:0;visibility:hidden;pointer-events:none}

.cover-frame{position:absolute;inset:10px;border:1px solid rgba(184,150,62,.2);pointer-events:none;z-index:1}
.cover-frame::before{content:'';position:absolute;inset:5px;border:1px solid rgba(184,150,62,.07)}

/* Corner ornaments – smaller on mobile */
.co{position:absolute;width:clamp(32px,8vw,52px);height:clamp(32px,8vw,52px);pointer-events:none;z-index:2}
.co svg{width:100%;height:100%}
.co-tl{top:10px;left:10px}
.co-tr{top:10px;right:10px;transform:scaleX(-1)}
.co-bl{bottom:10px;left:10px;transform:scaleY(-1)}
.co-br{bottom:10px;right:10px;transform:scale(-1)}

.c-wayang{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:min(320px,65vw);opacity:.06;pointer-events:none;z-index:1;animation:floatY 14s ease-in-out infinite alternate}
.c-janur-l{position:absolute;bottom:0;left:0;width:min(220px,38vw);opacity:.16;pointer-events:none;z-index:1;transform-origin:bottom left;animation:swayL 10s ease-in-out infinite alternate}
.c-janur-r{position:absolute;bottom:0;right:0;width:min(220px,38vw);opacity:.16;pointer-events:none;z-index:1;transform-origin:bottom right;transform:scaleX(-1);animation:swayR 11s ease-in-out infinite alternate}

.cover-inner{position:relative;z-index:3;width:100%;max-width:420px;animation:fadeUp 1.4s cubic-bezier(.215,.61,.355,1) forwards}

.c-bismillah{font-family:'Amiri',serif;font-size:clamp(1rem,3.5vw,1.25rem);color:var(--gold-lt);letter-spacing:.04em;margin-bottom:clamp(.8rem,3vw,1.4rem);line-height:2;opacity:.9}
.c-label{font-family:'Cinzel',serif;font-size:clamp(.5rem,1.8vw,.6rem);letter-spacing:.38em;color:var(--sage-lt);text-transform:uppercase;margin-bottom:clamp(.6rem,2vw,1.2rem)}
.c-names{font-family:'Cormorant',serif;font-size:var(--t-display);font-weight:300;color:var(--parch);line-height:1.05;text-shadow:0 3px 24px rgba(0,0,0,.45)}
.c-names .amp{font-style:italic;color:var(--gold);font-size:.62em;display:block;text-shadow:0 0 30px var(--gold-glow);margin:-.1em 0}
.c-ornline{display:flex;align-items:center;gap:.7rem;justify-content:center;margin:clamp(.8rem,3vw,1.2rem) 0}
.c-ornline::before,.c-ornline::after{content:'';flex:1;max-width:70px;height:1px;background:linear-gradient(90deg,transparent,var(--gold))}
.c-ornline::after{background:linear-gradient(90deg,var(--gold),transparent)}
.c-ornline span{font-family:'Amiri',serif;font-size:.9rem;color:var(--gold);opacity:.8}
.c-date{font-family:'Cinzel',serif;font-size:clamp(.55rem,1.8vw,.72rem);letter-spacing:.24em;color:var(--parch-warm);margin:.3rem 0 clamp(.8rem,3vw,1.4rem);opacity:.8}
.c-guest-label{font-size:clamp(.58rem,1.8vw,.65rem);color:var(--sage-lt);letter-spacing:.1em;margin-bottom:.3rem}
.c-guest-name{font-family:'Cormorant',serif;font-style:italic;font-size:clamp(1rem,3.5vw,1.2rem);color:var(--gold-lt);margin-bottom:clamp(1.2rem,4vw,2rem)}

.btn-open{
  display:inline-flex;align-items:center;gap:.5rem;
  padding:clamp(.75rem,2.5vw,.9rem) clamp(1.6rem,5vw,2.8rem);
  background:transparent;border:1px solid rgba(184,150,62,.5);
  color:var(--gold-lt);font-family:'Cinzel',serif;
  font-size:clamp(.55rem,1.8vw,.62rem);letter-spacing:.28em;text-transform:uppercase;
  cursor:pointer;border-radius:1px;transition:all .4s;position:relative;overflow:hidden;
  touch-action:manipulation;-webkit-tap-highlight-color:transparent;
}
.btn-open::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,var(--gold-dk),var(--gold));transform:scaleX(0);transform-origin:left;transition:transform .45s cubic-bezier(.77,0,.175,1)}
.btn-open:hover::before,.btn-open:active::before{transform:scaleX(1)}
.btn-open:hover,.btn-open:active{color:var(--ink)}
.btn-open span{position:relative;z-index:1}

/* ════════════════════════════
   ANIMATIONS
════════════════════════════ */
@keyframes fadeUp{0%{opacity:0;transform:translateY(28px)}100%{opacity:1;transform:translateY(0)}}
@keyframes floatY{0%{transform:translateX(-50%) translateY(0)}100%{transform:translateX(-50%) translateY(-10px)}}
@keyframes swayL{0%{transform:rotate(0deg)}100%{transform:rotate(3deg) translateY(-5px)}}
@keyframes swayR{0%{transform:scaleX(-1) rotate(0deg)}100%{transform:scaleX(-1) rotate(3deg) translateY(-5px)}}
@keyframes swayTop{0%{transform:translateX(-50%) rotate(-1.4deg)}100%{transform:translateX(-50%) rotate(1.4deg)}}
@keyframes floatMtn{0%{transform:translateX(-50%) translateY(0)}100%{transform:translateX(-50%) translateY(-6px)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes scrollAnim{0%{transform:scaleY(0);transform-origin:top;opacity:1}50%{transform:scaleY(1);transform-origin:top;opacity:1}51%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom;opacity:0}}
@keyframes rsvpIn{0%{opacity:0;transform:translateY(10px)}100%{opacity:1;transform:translateY(0)}}

/* ════════════════════════════
   MAIN
════════════════════════════ */
main{display:none;opacity:0;transition:opacity 1.2s ease}
main.visible{display:block;opacity:1}

/* ── Reveals ── */
.rev{opacity:0;transform:translateY(34px);transition:opacity .85s cubic-bezier(.215,.61,.355,1),transform .85s cubic-bezier(.215,.61,.355,1)}
.rev.on{opacity:1;transform:translateY(0)}
.rev-l{opacity:0;transform:translateX(-36px);transition:opacity .85s cubic-bezier(.215,.61,.355,1),transform .85s cubic-bezier(.215,.61,.355,1)}
.rev-l.on{opacity:1;transform:translateX(0)}
.rev-r{opacity:0;transform:translateX(36px);transition:opacity .85s cubic-bezier(.215,.61,.355,1),transform .85s cubic-bezier(.215,.61,.355,1)}
.rev-r.on{opacity:1;transform:translateX(0)}
.rev-s{opacity:0;transform:scale(.9);transition:opacity .85s cubic-bezier(.215,.61,.355,1),transform .85s cubic-bezier(.215,.61,.355,1)}
.rev-s.on{opacity:1;transform:scale(1)}
/* On mobile, replace horizontal reveals with vertical to avoid clipping */
@media(max-width:480px){
  .rev-l,.rev-r{transform:translateY(28px)}
  .rev-l.on,.rev-r.on{transform:translateY(0)}
}
.d1{transition-delay:.1s}.d2{transition-delay:.2s}.d3{transition-delay:.32s}.d4{transition-delay:.44s}.d5{transition-delay:.56s}

/* ── Section base ── */
section{padding:var(--sec-pad);position:relative;overflow:hidden}

/* ── Common typographic elements ── */
.s-eyebrow{font-family:'Cinzel',serif;font-size:clamp(.48rem,1.6vw,.56rem);letter-spacing:.4em;color:var(--sage);text-transform:uppercase;text-align:center;margin-bottom:.6rem}
.s-title{font-family:'Cormorant',serif;font-weight:300;font-size:var(--t-h1);text-align:center;color:var(--ink-soft);line-height:1.15;margin-bottom:.4rem}
.s-title em{font-style:italic;color:var(--marun)}
.s-title-lt{color:var(--parch)!important}
.s-title-lt em{color:var(--gold)!important}

.ornline{display:flex;align-items:center;gap:.8rem;justify-content:center;margin:.7rem auto 1rem;max-width:260px}
.ornline::before,.ornline::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--cream-line))}
.ornline::after{background:linear-gradient(90deg,var(--cream-line),transparent)}
.ornline-dk::before{background:linear-gradient(90deg,transparent,rgba(184,150,62,.32))}
.ornline-dk::after{background:linear-gradient(90deg,rgba(184,150,62,.32),transparent)}
.ornline span{font-family:'Amiri',serif;font-size:.85rem;color:var(--gold);opacity:.75}

.sec-intro{text-align:center;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(.88rem,2.4vw,1rem);color:var(--muted);max-width:min(380px,90%);margin:0 auto;line-height:1.85}

/* ════════════════════════════
   HERO
════════════════════════════ */
.hero{
  min-height:100svh;position:relative;overflow:hidden;
  background:linear-gradient(185deg,var(--forest) 0%,#152518 45%,#1C1008 100%);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;
  padding:clamp(4rem,10vw,6rem) clamp(1.2rem,5vw,3rem) clamp(5rem,10vw,7rem);
}
.hero::before{content:'';position:absolute;inset:0;opacity:.35;pointer-events:none;z-index:0;background:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E")}
.hero-mountain{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:min(700px,100%);opacity:.12;z-index:0;animation:floatMtn 12s ease-in-out infinite alternate}
.hero-sage{position:absolute;top:-8px;left:50%;transform:translateX(-50%);width:min(560px,88%);opacity:.25;z-index:0;transform-origin:top center;animation:swayTop 16s ease-in-out infinite alternate}
.hero-janur-l{position:absolute;bottom:0;left:0;width:min(200px,32vw);opacity:.2;z-index:0;transform-origin:bottom left;animation:swayL 12s ease-in-out infinite alternate}
.hero-janur-r{position:absolute;bottom:0;right:0;width:min(200px,32vw);opacity:.2;z-index:0;transform-origin:bottom right;transform:scaleX(-1);animation:swayR 13s ease-in-out infinite alternate}
.hero-inner{position:relative;z-index:2;width:100%}
.hero-eyebrow{font-family:'Cinzel',serif;font-size:clamp(.48rem,1.8vw,.58rem);letter-spacing:.4em;color:var(--sage-lt);text-transform:uppercase;margin-bottom:1rem}
.hero-names{font-family:'Cormorant',serif;font-weight:300;font-size:var(--t-display);color:var(--parch);line-height:1;text-shadow:0 5px 30px rgba(0,0,0,.35);letter-spacing:.01em}
.hero-names em{display:block;font-style:italic;color:var(--gold);font-size:.6em;font-weight:300;text-shadow:0 0 35px var(--gold-glow);margin:-.02em 0}
.hero-date{font-family:'Cinzel',serif;font-size:clamp(.55rem,1.8vw,.7rem);letter-spacing:.26em;color:var(--gold-lt);margin-top:1.1rem;opacity:.85}
.scroll-hint{position:absolute;bottom:clamp(1.4rem,4vw,2.2rem);left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:.4rem;color:rgba(168,184,158,.32);font-family:'Cinzel',serif;font-size:.46rem;letter-spacing:.2em;text-transform:uppercase;z-index:2}
.scroll-line{width:1px;height:26px;background:linear-gradient(to bottom,var(--sage-lt),transparent);animation:scrollAnim 2.2s ease-in-out infinite}

/* ════════════════════════════
   QUOTE
════════════════════════════ */
.quote-sec{background:linear-gradient(175deg,var(--forest) 0%,#0E1C11 60%,#120A06 100%);text-align:center;padding:var(--sec-pad);position:relative;overflow:hidden}
.quote-sec::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,rgba(184,150,62,.05) 0%,transparent 65%);pointer-events:none}
.batik-bg{position:absolute;inset:0;opacity:.025;background-image:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23B8963E' fill-opacity='1'%3E%3Cpath d='M30 0 L60 30 L30 60 L0 30 Z M30 10 L50 30 L30 50 L10 30 Z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");pointer-events:none;z-index:0}
.q-gunungan{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(280px,55vw);opacity:.04;animation:floatY 15s ease-in-out infinite alternate;pointer-events:none;z-index:0}
.q-arabic{font-family:'Amiri',serif;font-size:clamp(1rem,3.2vw,1.4rem);color:var(--gold-lt);margin-bottom:1rem;line-height:2.1;text-shadow:0 0 18px var(--gold-glow);position:relative;z-index:1;padding:0 .5rem}
.q-text{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(.88rem,2.6vw,1.05rem);color:rgba(249,244,234,.55);max-width:min(460px,92%);margin:0 auto .8rem;line-height:1.85;position:relative;z-index:1}
.q-ref{font-family:'Cinzel',serif;font-size:clamp(.48rem,1.6vw,.56rem);letter-spacing:.22em;color:var(--sage-lt);text-transform:uppercase;position:relative;z-index:1}

/* ════════════════════════════
   COUPLE
════════════════════════════ */
.couple-sec{background:var(--parch);position:relative;padding-bottom:clamp(4rem,8vw,7rem)}
.couple-sec::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--cream-line),transparent)}
.couple-grid{display:grid;grid-template-columns:1fr;gap:clamp(1.2rem,4vw,2rem);max-width:min(360px,95%);margin:1.5rem auto 0}
.and-sep{text-align:center;font-family:'Cormorant',serif;font-style:italic;font-size:clamp(2.2rem,7vw,3rem);font-weight:300;color:var(--gold);text-shadow:0 0 14px var(--gold-glow);line-height:1;padding:.2rem 0}

.card{background:#fff;border:1px solid rgba(184,150,62,.13);border-radius:2px;padding:clamp(1.8rem,5vw,2.8rem) clamp(1.2rem,4vw,1.8rem);text-align:center;position:relative;box-shadow:0 8px 30px rgba(26,20,16,.05);transition:transform .5s,box-shadow .5s}
.card:hover{transform:translateY(-5px);box-shadow:0 16px 45px rgba(26,20,16,.08)}
.card::before{content:'';position:absolute;top:7px;left:7px;right:7px;bottom:7px;border:1px solid rgba(184,150,62,.07);pointer-events:none}
.card-corner{position:absolute;width:18px;height:18px}
.card-corner svg{width:100%;height:100%}
.card-corner.tl{top:3px;left:3px}.card-corner.tr{top:3px;right:3px;transform:scaleX(-1)}
.card-corner.bl{bottom:3px;left:3px;transform:scaleY(-1)}.card-corner.br{bottom:3px;right:3px;transform:scale(-1)}
.card-photo{width:clamp(90px,22vw,120px);height:clamp(90px,22vw,120px);border-radius:50%;margin:0 auto clamp(.8rem,3vw,1.4rem);background:linear-gradient(135deg,var(--parch-warm),var(--parch-deep));border:2px solid rgba(184,150,62,.22);display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:0 6px 20px rgba(0,0,0,.07);transition:transform .4s;font-size:2rem}
.card:hover .card-photo{transform:scale(1.04)}
.card-photo img{width:100%;height:100%;object-fit:cover}
.card-role{font-family:'Cinzel',serif;font-size:clamp(.46rem,1.5vw,.52rem);letter-spacing:.28em;color:var(--sage);text-transform:uppercase;margin-bottom:.45rem}
.card-name{font-family:'Cormorant',serif;font-size:clamp(1.4rem,4.5vw,1.8rem);font-weight:400;color:var(--ink-soft);margin-bottom:.1rem}
.card-fullname{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(.8rem,2.4vw,.88rem);color:var(--muted);margin-bottom:.8rem}
.card-div{height:1px;background:linear-gradient(90deg,transparent,var(--cream-line),transparent);margin:.8rem 0}
.card-parents{font-size:clamp(.72rem,2.2vw,.78rem);color:var(--muted);line-height:1.7}
.card-parents strong{color:var(--ink-soft);font-weight:400;display:block;font-size:clamp(.74rem,2.3vw,.82rem)}

@media(min-width:640px){
  .couple-grid{grid-template-columns:1fr auto 1fr;max-width:min(700px,95%);align-items:center}
  .and-sep{font-size:3.5rem;padding:0 .5rem}
}

/* ════════════════════════════
   COUNTDOWN
════════════════════════════ */
.cd-sec{background:linear-gradient(170deg,var(--ink-soft) 0%,#1A120A 100%);text-align:center;padding:var(--sec-pad);position:relative;overflow:hidden}
.cd-sec::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 25% 50%,rgba(107,45,58,.12) 0%,transparent 55%),radial-gradient(ellipse at 75% 50%,rgba(30,50,34,.2) 0%,transparent 55%);pointer-events:none}
.cd-mountain{position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:min(600px,100%);opacity:.06;animation:floatMtn 14s ease-in-out infinite alternate;pointer-events:none}
.cd-grid{display:flex;justify-content:center;gap:clamp(.35rem,2vw,.9rem);margin-top:clamp(1.5rem,4vw,2.5rem);flex-wrap:nowrap;position:relative;z-index:1}
.cd-item{text-align:center;flex:1;max-width:80px;min-width:0;padding:clamp(.8rem,2.5vw,1.2rem) clamp(.3rem,1.5vw,.6rem);background:rgba(184,150,62,.04);border:1px solid rgba(184,150,62,.12);border-radius:2px;position:relative;transition:border-color .3s,transform .3s}
.cd-item:hover{transform:translateY(-3px);border-color:rgba(184,150,62,.28)}
.cd-item::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(184,150,62,.3),transparent)}
.cd-num{font-family:'Cormorant',serif;font-size:clamp(1.8rem,7vw,3rem);font-weight:300;color:var(--gold-lt);display:block;line-height:1;margin-bottom:.3rem;text-shadow:0 0 18px var(--gold-glow);transition:transform .25s,opacity .25s}
.cd-lbl{font-family:'Cinzel',serif;font-size:clamp(.38rem,1.3vw,.48rem);letter-spacing:.16em;color:rgba(249,244,234,.28);text-transform:uppercase}
.cd-sep{font-size:clamp(1.2rem,4vw,2rem);color:rgba(184,150,62,.18);align-self:center;padding-bottom:clamp(.6rem,2vw,1rem);font-family:'Cormorant',serif;flex-shrink:0}

/* ════════════════════════════
   EVENT
════════════════════════════ */
.event-sec{background:var(--parch);position:relative}
.event-sec::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--cream-line),transparent)}
.event-card{width:min(380px,100%);margin:2rem auto 0;background:linear-gradient(158deg,var(--forest-md) 0%,var(--forest) 50%,#0E1A10 100%);color:var(--parch);border-radius:2px;padding:clamp(2rem,6vw,3rem) clamp(1.4rem,5vw,2.2rem);text-align:center;position:relative;overflow:hidden;box-shadow:0 20px 55px rgba(0,0,0,.14);transition:transform .4s}
.event-card:hover{transform:translateY(-4px)}
.event-card::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(184,150,62,.08) 0%,transparent 60%);pointer-events:none}
.event-frame{position:absolute;inset:10px;border:1px solid rgba(184,150,62,.11);pointer-events:none}
.event-frame::before{content:'';position:absolute;inset:5px;border:1px solid rgba(184,150,62,.05)}
.event-gunungan{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(180px,40vw);opacity:.035;animation:floatY 14s ease-in-out infinite alternate;pointer-events:none}
.event-type{font-family:'Cinzel',serif;font-size:clamp(.46rem,1.5vw,.52rem);letter-spacing:.35em;color:var(--sage-lt);text-transform:uppercase;margin-bottom:.9rem;position:relative;z-index:1}
.event-name{font-family:'Cormorant',serif;font-size:clamp(1.5rem,5vw,1.8rem);font-weight:300;margin-bottom:1.2rem;position:relative;z-index:1}
.event-row{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(.85rem,2.6vw,.98rem);color:rgba(249,244,234,.55);line-height:1.8;margin-bottom:.25rem;position:relative;z-index:1}
.event-row strong{font-style:normal;color:var(--gold-lt);font-weight:400;display:block;font-size:clamp(.92rem,2.8vw,1.02rem)}
.event-div{height:1px;background:linear-gradient(90deg,transparent,rgba(184,150,62,.25),transparent);margin:1rem 0;position:relative;z-index:1}
.btn-map{display:inline-block;margin-top:1.2rem;padding:clamp(.6rem,2vw,.7rem) clamp(1.3rem,4vw,1.8rem);border:1px solid rgba(184,150,62,.4);color:var(--gold-lt);font-family:'Cinzel',serif;font-size:clamp(.5rem,1.6vw,.58rem);letter-spacing:.22em;text-transform:uppercase;text-decoration:none;transition:all .4s;position:relative;overflow:hidden;border-radius:1px;z-index:1;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.btn-map::before{content:'';position:absolute;inset:0;background:var(--gold);transform:scaleX(0);transform-origin:left;transition:transform .4s}
.btn-map:hover::before,.btn-map:active::before{transform:scaleX(1)}
.btn-map:hover,.btn-map:active{color:var(--ink)}
.btn-map span{position:relative;z-index:1}

/* ════════════════════════════
   GALLERY
════════════════════════════ */
.gallery-sec{background:var(--forest);padding:clamp(3rem,7vw,4.5rem) 0 clamp(3.5rem,7vw,5rem);overflow:hidden;position:relative}
.gallery-sec::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,26,16,.8) 0%,transparent 30%,transparent 70%,rgba(14,26,16,.8) 100%);pointer-events:none;z-index:1}
.gallery-strip{display:flex;gap:clamp(.6rem,2vw,1rem);padding:0 clamp(1rem,4vw,1.5rem);overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;position:relative;z-index:2;padding-top:.3rem;padding-bottom:.3rem}
.gallery-strip::-webkit-scrollbar{display:none}
.gallery-item{min-width:clamp(140px,40vw,220px);height:clamp(200px,52vw,300px);border-radius:2px;overflow:hidden;scroll-snap-align:start;flex-shrink:0;transition:transform .4s,box-shadow .4s;box-shadow:0 8px 28px rgba(0,0,0,.28);border:1px solid rgba(184,150,62,.1)}
.gallery-item img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.gallery-item:hover img{transform:scale(1.07)}

/* ════════════════════════════
   RSVP
════════════════════════════ */
.rsvp-sec{background:var(--parch-warm);position:relative}
.rsvp-sec::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--cream-line),transparent)}
.rsvp-form{width:min(400px,100%);margin:1.8rem auto 0}
.fg{margin-bottom:1rem}
.fg label{display:block;font-family:'Cinzel',serif;font-size:clamp(.48rem,1.5vw,.54rem);letter-spacing:.16em;color:var(--muted);text-transform:uppercase;margin-bottom:.4rem}
.fg input[type="text"],
.fg input[type="number"],
.fg select,
.fg textarea{
  width:100%;
  padding:clamp(.7rem,2.5vw,.85rem) clamp(.85rem,3vw,1.1rem);
  border:1px solid rgba(107,45,58,.18);
  background:rgba(255,255,255,.75);
  color:var(--ink);
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(.9rem,2.8vw,.95rem);
  font-weight:400;
  outline:none;
  transition:border-color .3s,box-shadow .3s;
  border-radius:2px;
  -webkit-appearance:none;
  appearance:none;
  /* prevent iOS zoom on focus – minimum 16px renders as 1rem */
  font-size:max(.9rem,16px);
}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--marun);box-shadow:0 0 0 3px rgba(107,45,58,.08)}
.radio-grp{display:flex;gap:.6rem}
.radio-opt{flex:1;display:flex;align-items:center;justify-content:center;gap:.4rem;padding:clamp(.65rem,2.5vw,.8rem);border:1px solid rgba(107,45,58,.18);cursor:pointer;font-family:'Cinzel',serif;font-size:clamp(.52rem,1.7vw,.58rem);letter-spacing:.08em;color:var(--muted);text-transform:uppercase;transition:all .3s;border-radius:2px;background:rgba(255,255,255,.5);touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.radio-opt input[type="radio"]{display:none}
.radio-opt.sel{border-color:var(--marun);background:rgba(107,45,58,.07);color:var(--marun)}
.btn-submit{width:100%;padding:clamp(.85rem,3vw,1rem);background:linear-gradient(135deg,var(--forest),var(--forest-md));color:var(--gold-lt);border:none;font-family:'Cinzel',serif;font-size:clamp(.54rem,1.8vw,.6rem);letter-spacing:.28em;text-transform:uppercase;cursor:pointer;margin-top:.4rem;transition:all .35s;border-radius:2px;box-shadow:0 5px 18px rgba(0,0,0,.1);position:relative;overflow:hidden;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.btn-submit::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,var(--gold-dk),var(--gold));transform:scaleX(0);transform-origin:left;transition:transform .45s cubic-bezier(.77,0,.175,1)}
.btn-submit:hover::before,.btn-submit:active::before{transform:scaleX(1)}
.btn-submit:hover,.btn-submit:active{color:var(--ink)}
.btn-submit span{position:relative;z-index:1}
.btn-submit.loading{pointer-events:none;opacity:.7}

#rsvp-success{display:none;text-align:center;padding:clamp(1.8rem,5vw,2.5rem) clamp(1.2rem,4vw,2rem);background:rgba(30,50,34,.06);border:1px solid rgba(30,50,34,.12);border-radius:2px;animation:rsvpIn .6s cubic-bezier(.215,.61,.355,1)}
#rsvp-success .s-icon{font-size:2rem;margin-bottom:.7rem}
#rsvp-success p{font-family:'Cormorant',serif;font-style:italic;font-size:clamp(1rem,3vw,1.1rem);color:var(--forest-md);line-height:1.7}

/* ════════════════════════════
   WISHES
════════════════════════════ */
.wishes-sec{background:var(--parch);padding:var(--sec-pad)}
.wishes-list{max-width:min(420px,100%);margin:1.5rem auto 0;display:flex;flex-direction:column;gap:.75rem}
.wish-card{background:#fff;padding:clamp(1rem,4vw,1.4rem) clamp(1rem,4vw,1.5rem);border-radius:2px;border:1px solid rgba(184,150,62,.1);box-shadow:0 3px 12px rgba(0,0,0,.03);transition:transform .3s;position:relative;overflow:hidden}
.wish-card::before{content:'"';position:absolute;top:.5rem;right:.9rem;font-family:'Cormorant',serif;font-size:3rem;font-weight:300;color:rgba(184,150,62,.11);line-height:1;pointer-events:none}
.wish-name{font-family:'Cormorant',serif;font-size:clamp(.9rem,2.8vw,1rem);font-weight:500;color:var(--ink-soft);margin-bottom:.2rem}
.wish-attend{font-family:'Cinzel',serif;font-size:clamp(.44rem,1.4vw,.48rem);letter-spacing:.16em;text-transform:uppercase;color:var(--sage);margin-bottom:.4rem}
.wish-msg{font-size:clamp(.76rem,2.3vw,.8rem);color:var(--muted);line-height:1.65;font-style:italic}
.wish-time{font-size:clamp(.55rem,1.7vw,.6rem);color:rgba(122,106,85,.4);margin-top:.4rem}

/* ════════════════════════════
   GIFT
════════════════════════════ */
.gift-sec{background:var(--parch-warm);text-align:center;position:relative}
.gift-sec::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--cream-line),transparent)}
.gift-card{width:min(340px,100%);margin:1.8rem auto 0;border:1px solid rgba(184,150,62,.18);padding:clamp(1.6rem,5vw,2.2rem) clamp(1.2rem,4vw,2rem);background:#fff;border-radius:2px;box-shadow:0 10px 32px rgba(0,0,0,.04);transition:transform .4s,box-shadow .4s;position:relative}
.gift-card::before{content:'';position:absolute;top:6px;left:6px;right:6px;bottom:6px;border:1px solid rgba(184,150,62,.06);pointer-events:none}
.gift-card:hover{transform:translateY(-4px);box-shadow:0 18px 42px rgba(0,0,0,.07)}
.gift-bank{font-family:'Cinzel',serif;font-size:clamp(.48rem,1.5vw,.52rem);letter-spacing:.28em;color:var(--sage);text-transform:uppercase;margin-bottom:.3rem}
.gift-name{font-family:'Cormorant',serif;font-size:clamp(1rem,3.2vw,1.15rem);font-weight:400;margin-bottom:.25rem;color:var(--ink-soft)}
.gift-acc{font-family:'Cormorant Garamond',serif;font-size:clamp(1.15rem,4vw,1.45rem);color:var(--muted);letter-spacing:.1em;margin-bottom:1rem}
.btn-copy{padding:clamp(.55rem,2vw,.65rem) clamp(1.1rem,3.5vw,1.5rem);border:1px solid rgba(184,150,62,.35);background:transparent;color:var(--gold-dk);font-family:'Cinzel',serif;font-size:clamp(.5rem,1.6vw,.58rem);letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:all .35s;border-radius:1px;position:relative;overflow:hidden;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.btn-copy::before{content:'';position:absolute;inset:0;background:var(--gold);transform:scaleX(0);transform-origin:left;transition:transform .35s}
.btn-copy:hover::before,.btn-copy:active::before{transform:scaleX(1)}
.btn-copy:hover,.btn-copy:active{color:#fff}
.btn-copy span{position:relative;z-index:1}

/* Toast */
.copy-toast{position:fixed;bottom:5rem;left:50%;transform:translateX(-50%) translateY(14px);background:var(--forest-md);color:var(--gold-lt);padding:.65rem clamp(.9rem,3vw,1.5rem);border-radius:50px;font-family:'Cinzel',serif;font-size:clamp(.52rem,1.7vw,.58rem);letter-spacing:.1em;opacity:0;transition:all .4s;z-index:200;pointer-events:none;box-shadow:0 5px 22px rgba(0,0,0,.22);white-space:nowrap}
.copy-toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ════════════════════════════
   FOOTER
════════════════════════════ */
footer{background:linear-gradient(180deg,var(--forest) 0%,#090E09 100%);text-align:center;padding:clamp(3.5rem,8vw,5rem) clamp(1.2rem,5vw,3rem) clamp(2rem,5vw,3.5rem);color:rgba(249,244,234,.3);position:relative;overflow:hidden}
footer::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(184,150,62,.25),transparent)}
.footer-wayang{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(200px,45vw);opacity:.025;animation:floatY 15s ease-in-out infinite alternate;pointer-events:none}
.footer-names{font-family:'Cormorant',serif;font-weight:300;font-size:clamp(1.6rem,5.5vw,2rem);color:var(--gold-lt);margin-bottom:.4rem;text-shadow:0 0 18px var(--gold-glow);position:relative;z-index:1}
.footer-date{font-family:'Cinzel',serif;font-size:clamp(.52rem,1.6vw,.6rem);letter-spacing:.25em;color:rgba(249,244,234,.32);margin-bottom:1.2rem;position:relative;z-index:1}
.footer-msg{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(.82rem,2.5vw,.95rem);color:rgba(249,244,234,.32);max-width:min(380px,90%);margin:0 auto 1.5rem;line-height:1.85;position:relative;z-index:1}
.footer-made{font-family:'Cinzel',serif;font-size:clamp(.46rem,1.4vw,.5rem);letter-spacing:.16em;color:rgba(249,244,234,.16);position:relative;z-index:1}

/* ════════════════════════════
   FLOATING NAV
════════════════════════════ */
.f-nav{position:fixed;bottom:clamp(1rem,3vw,1.5rem);left:50%;transform:translateX(-50%);z-index:50;display:flex;background:rgba(26,20,16,.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-radius:50px;padding:.28rem .42rem;box-shadow:0 4px 28px rgba(0,0,0,.28);border:1px solid rgba(184,150,62,.1)}
.f-nav-btn{width:clamp(36px,9vw,40px);height:clamp(36px,9vw,40px);border:none;background:transparent;color:rgba(184,150,62,.3);cursor:pointer;font-size:clamp(.85rem,2.5vw,.95rem);border-radius:50%;display:flex;align-items:center;justify-content:center;transition:all .3s;text-decoration:none;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.f-nav-btn:hover,.f-nav-btn:active,.f-nav-btn.act{background:rgba(184,150,62,.1);color:var(--gold);transform:scale(1.1)}

/* ════════════════════════════
   MUSIC PLAYER
════════════════════════════ */
#mp{position:fixed;right:clamp(.8rem,3vw,1.2rem);top:50%;transform:translateY(-50%);z-index:60;display:none;cursor:pointer;width:clamp(34px,9vw,40px);height:clamp(34px,9vw,40px);border-radius:50%;border:none;background:none;padding:0;transition:transform .35s;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
#mp:hover{transform:translateY(-50%) scale(1.15)}
#mp.vis{display:block}
.disc{width:100%;height:100%;border-radius:50%;position:relative;background:conic-gradient(#1a1a1a,#252525,#1a1a1a,#252525,#1a1a1a);box-shadow:0 3px 16px rgba(0,0,0,.45),0 0 0 1px rgba(184,150,62,.18)}
.disc::after{content:'';position:absolute;inset:36%;border-radius:50%;background:var(--gold);box-shadow:0 0 0 2px #111,0 0 8px var(--gold-glow)}
.disc.spin{animation:spin 3s linear infinite}

/* ════════════════════════════
   PRINT / REDUCED MOTION
════════════════════════════ */
@media(prefers-reduced-motion:reduce){
  *{animation-duration:.01ms!important;transition-duration:.01ms!important}
}
</style>
</head>
<body>

<canvas id="pc"></canvas>
<div class="copy-toast" id="copyToast">✓ Nomor rekening tersalin</div>

<audio id="bgm" loop preload="auto">
  <source src="https://raw.githubusercontent.com/azkrekk/undangan-rekiya/main/musik.mp3" type="audio/mpeg">
</audio>
<button id="mp" onclick="toggleMusic()" title="Play / Pause" aria-label="Play atau pause musik">
  <div class="disc" id="disc"></div>
</button>

<!-- ══ COVER ══ -->
<div id="cover">
  <div class="cover-frame"></div>
  <div class="co co-tl"><svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 38 L2 2 L38 2" stroke="#B8963E" stroke-width="1" stroke-opacity="0.5"/><path d="M8 32 L8 8 L32 8" stroke="#B8963E" stroke-width="0.5" stroke-opacity="0.25"/><circle cx="2" cy="2" r="1.5" fill="#B8963E" fill-opacity="0.6"/></svg></div>
  <div class="co co-tr"><svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 38 L2 2 L38 2" stroke="#B8963E" stroke-width="1" stroke-opacity="0.5"/><path d="M8 32 L8 8 L32 8" stroke="#B8963E" stroke-width="0.5" stroke-opacity="0.25"/><circle cx="2" cy="2" r="1.5" fill="#B8963E" fill-opacity="0.6"/></svg></div>
  <div class="co co-bl"><svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 38 L2 2 L38 2" stroke="#B8963E" stroke-width="1" stroke-opacity="0.5"/><path d="M8 32 L8 8 L32 8" stroke="#B8963E" stroke-width="0.5" stroke-opacity="0.25"/><circle cx="2" cy="2" r="1.5" fill="#B8963E" fill-opacity="0.6"/></svg></div>
  <div class="co co-br"><svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 38 L2 2 L38 2" stroke="#B8963E" stroke-width="1" stroke-opacity="0.5"/><path d="M8 32 L8 8 L32 8" stroke="#B8963E" stroke-width="0.5" stroke-opacity="0.25"/><circle cx="2" cy="2" r="1.5" fill="#B8963E" fill-opacity="0.6"/></svg></div>

  <img src="assets/img/gunungan.png" alt="" class="c-wayang" aria-hidden="true">
  <img src="assets/img/rama.png"     alt="" class="c-janur-l" aria-hidden="true">
  <img src="assets/img/Shinta.png"   alt="" class="c-janur-r" aria-hidden="true">

  <div class="cover-inner">
    <p class="c-bismillah">بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ</p>
    <p class="c-label">The Wedding Of</p>
    <h1 class="c-names">Azkiya<span class="amp">&</span>Reineta</h1>
    <div class="c-ornline"><span>✦</span></div>
    <p class="c-date">SABTU · 28 NOVEMBER 2026</p>
    <p class="c-guest-label">Kepada Yth.</p>
    <p class="c-guest-name" id="cover-guest-name">Tamu Undangan</p>
    <button class="btn-open" onclick="openInvitation()"><span>Buka Undangan</span></button>
  </div>
</div>

<!-- ══ MAIN ══ -->
<main id="main">

  <!-- HERO -->
  <section class="hero" id="home">
    <img src="assets/img/mountain.png" alt="" class="hero-mountain" aria-hidden="true">
    <img src="assets/img/joglo.png"    alt="" class="hero-sage"     aria-hidden="true">
    <img src="assets/img/rama.png"     alt="" class="hero-janur-l"  aria-hidden="true">
    <img src="assets/img/Shinta.png"   alt="" class="hero-janur-r"  aria-hidden="true">
    <div class="hero-inner">
      <p class="hero-eyebrow rev">The Wedding Of</p>
      <h1 class="hero-names rev d1">Azki<em>& Rein</em></h1>
      <div class="ornline ornline-dk rev d2"><span>✦</span></div>
      <p class="hero-date rev d3">Sabtu, 28 November 2026</p>
    </div>
    <div class="scroll-hint" aria-hidden="true"><span>Scroll</span><div class="scroll-line"></div></div>
  </section>

  <!-- QUOTE -->
  <section class="quote-sec" id="quote">
    <div class="batik-bg" aria-hidden="true"></div>
    <img src="assets/img/gunungan.png" alt="" class="q-gunungan" aria-hidden="true">
    <p class="q-arabic rev">وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَاجًا لِّتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةً</p>
    <div class="ornline rev d1"><span>✦</span></div>
    <p class="q-text rev d2">"Dan di antara tanda-tanda kebesaran-Nya ialah Dia menciptakan pasangan-pasangan untukmu dari jenismu sendiri, agar kamu cenderung dan merasa tenteram kepadanya, dan Dia menjadikan di antaramu rasa kasih dan sayang."</p>
    <p class="q-ref rev d3">— QS. Ar-Rum : 21 —</p>
  </section>

  <!-- COUPLE -->
  <section class="couple-sec" id="couple">
    <p class="s-eyebrow rev">Mempelai</p>
    <h2 class="s-title rev d1">Kedua <em>Mempelai</em></h2>
    <div class="ornline rev d2"><span>✦</span></div>
    <p class="sec-intro rev d3">Dengan memohon rahmat dan ridho Allah SWT, kami mengundang Bapak/Ibu/Saudara/i untuk hadir dan memberikan doa restu.</p>
    <div class="couple-grid">
      <div class="card rev-l">
        <div class="card-corner tl"><svg viewBox="0 0 20 20" fill="none"><path d="M1 19 L1 1 L19 1" stroke="#B8963E" stroke-width="0.75" stroke-opacity="0.4"/></svg></div>
        <div class="card-corner tr"><svg viewBox="0 0 20 20" fill="none"><path d="M1 19 L1 1 L19 1" stroke="#B8963E" stroke-width="0.75" stroke-opacity="0.4"/></svg></div>
        <div class="card-corner bl"><svg viewBox="0 0 20 20" fill="none"><path d="M1 19 L1 1 L19 1" stroke="#B8963E" stroke-width="0.75" stroke-opacity="0.4"/></svg></div>
        <div class="card-corner br"><svg viewBox="0 0 20 20" fill="none"><path d="M1 19 L1 1 L19 1" stroke="#B8963E" stroke-width="0.75" stroke-opacity="0.4"/></svg></div>
        <div class="card-photo"><img src="assets/img/azkia.png" alt="Azkiya Tsany Baharsyah" onerror="this.parentElement.innerHTML='🤵'"></div>
        <p class="card-role">Mempelai Pria</p>
        <h3 class="card-name">Azkiya</h3>
        <p class="card-fullname">Azkiya Tsany Baharsyah, M.Ag.</p>
        <div class="card-div"></div>
        <p class="card-parents">Putra dari<strong>Bapak Muntohar & Ibu Siti Asbangunah</strong></p>
      </div>
      <div class="and-sep rev-s">&</div>
      <div class="card rev-r">
        <div class="card-corner tl"><svg viewBox="0 0 20 20" fill="none"><path d="M1 19 L1 1 L19 1" stroke="#B8963E" stroke-width="0.75" stroke-opacity="0.4"/></svg></div>
        <div class="card-corner tr"><svg viewBox="0 0 20 20" fill="none"><path d="M1 19 L1 1 L19 1" stroke="#B8963E" stroke-width="0.75" stroke-opacity="0.4"/></svg></div>
        <div class="card-corner bl"><svg viewBox="0 0 20 20" fill="none"><path d="M1 19 L1 1 L19 1" stroke="#B8963E" stroke-width="0.75" stroke-opacity="0.4"/></svg></div>
        <div class="card-corner br"><svg viewBox="0 0 20 20" fill="none"><path d="M1 19 L1 1 L19 1" stroke="#B8963E" stroke-width="0.75" stroke-opacity="0.4"/></svg></div>
        <div class="card-photo"><img src="assets/img/rein.png" alt="Reineta Dian Kusumawati" onerror="this.parentElement.innerHTML='👰'"></div>
        <p class="card-role">Mempelai Wanita</p>
        <h3 class="card-name">Reineta</h3>
        <p class="card-fullname">Reineta Dian Kusumawati, S.Pd.</p>
        <div class="card-div"></div>
        <p class="card-parents">Putri dari<strong>Bapak Toyik Haryanto & Ibu Nur 'Aini</strong></p>
      </div>
    </div>
  </section>

  <!-- COUNTDOWN -->
  <section class="cd-sec" id="countdown">
    <img src="assets/img/mountain.png" alt="" class="cd-mountain" aria-hidden="true">
    <p class="s-eyebrow rev" style="color:var(--sage-lt)">Hitung Mundur</p>
    <h2 class="s-title s-title-lt rev d1">Save the <em>Date</em></h2>
    <div class="ornline ornline-dk rev d2"><span>✦</span></div>
    <div class="cd-grid rev d3">
      <div class="cd-item"><span class="cd-num" id="cd-days">--</span><span class="cd-lbl">Hari</span></div>
      <div class="cd-sep">:</div>
      <div class="cd-item"><span class="cd-num" id="cd-hours">--</span><span class="cd-lbl">Jam</span></div>
      <div class="cd-sep">:</div>
      <div class="cd-item"><span class="cd-num" id="cd-mins">--</span><span class="cd-lbl">Menit</span></div>
      <div class="cd-sep">:</div>
      <div class="cd-item"><span class="cd-num" id="cd-secs">--</span><span class="cd-lbl">Detik</span></div>
    </div>
  </section>

  <!-- EVENT -->
  <section class="event-sec" id="event">
    <p class="s-eyebrow rev">Rangkaian Acara</p>
    <h2 class="s-title rev d1">Detail <em>Acara</em></h2>
    <div class="ornline rev d2"><span>✦</span></div>
    <div class="event-card rev-s d3">
      <div class="event-frame"></div>
      <img src="assets/img/gunungan.png" alt="" class="event-gunungan" aria-hidden="true">
      <p class="event-type">Akad Nikah & Resepsi</p>
      <h3 class="event-name">Akad & Resepsi</h3>
      <p class="event-row"><strong>Sabtu, 28 November 2026</strong></p>
      <div class="event-div"></div>
      <p class="event-row">Akad Nikah<strong>09.00 WIB – Selesai</strong></p>
      <p class="event-row">Resepsi<strong>11.00 WIB – Selesai</strong></p>
      <div class="event-div"></div>
      <p class="event-row"><strong>Grha Saraswati Wonogiri</strong></p>
      <p class="event-row">Wonogiri, Jawa Tengah</p>
      <a href="https://maps.app.goo.gl/6m2CWGgoAXXqwUZS9" target="_blank" rel="noopener" class="btn-map"><span>📍 Lihat Peta</span></a>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="gallery-sec" id="gallery">
    <p class="s-eyebrow rev" style="position:relative;z-index:3;padding:0 1.5rem">Galeri</p>
    <h2 class="s-title s-title-lt rev d1" style="position:relative;z-index:3;padding:0 1.5rem;margin-bottom:1.2rem">Momen <em>Bahagia</em></h2>
    <div class="gallery-strip rev d2">
      <div class="gallery-item"><img src="assets/img/gallery_1.png" alt="Momen 1" loading="lazy"></div>
      <div class="gallery-item"><img src="assets/img/gallery_2.png" alt="Momen 2" loading="lazy"></div>
      <div class="gallery-item"><img src="assets/img/gallery_3.png" alt="Momen 3" loading="lazy"></div>
      <div class="gallery-item"><img src="assets/img/gallery_4.png" alt="Momen 4" loading="lazy"></div>
      <div class="gallery-item"><img src="assets/img/gallery_5.png" alt="Momen 5" loading="lazy"></div>
    </div>
  </section>

  <!-- RSVP -->
  <section class="rsvp-sec" id="rsvp">
    <p class="s-eyebrow rev">Konfirmasi</p>
    <h2 class="s-title rev d1">Konfirmasi <em>Kehadiran</em></h2>
    <div class="ornline rev d2"><span>✦</span></div>
    <p class="sec-intro rev d3">Mohon konfirmasi kehadiran Anda agar kami dapat mempersiapkan segalanya dengan sepenuh hati.</p>
    <div class="rsvp-form rev d4">
      <div class="fg">
        <label for="rn">Nama Lengkap</label>
        <input type="text" id="rn" placeholder="Tulis nama Anda" autocomplete="name">
      </div>
      <div class="fg">
        <label>Kehadiran</label>
        <div class="radio-grp">
          <label class="radio-opt sel" id="opt-y" onclick="setAttend('y')"><input type="radio" name="attend" value="y" checked>✓ Hadir</label>
          <label class="radio-opt" id="opt-n" onclick="setAttend('n')"><input type="radio" name="attend" value="n">✗ Tidak Hadir</label>
        </div>
      </div>
      <div class="fg" id="jml-grp">
        <label for="rcount">Jumlah Tamu</label>
        <input type="number" id="rcount" value="1" min="1" max="20" inputmode="numeric">
      </div>
      <div class="fg">
        <label for="rmsg">Pesan & Doa</label>
        <textarea id="rmsg" rows="3" placeholder="Tuliskan ucapan dan doa untuk kedua mempelai…"></textarea>
      </div>
      <button class="btn-submit" id="submit-btn" onclick="submitRSVP()"><span>Kirim Konfirmasi</span></button>
    </div>
    <div id="rsvp-success"><div class="s-icon">🌸</div><p>Terima kasih telah mengkonfirmasi kehadiran Anda.<br>Kami dengan sukacita menantikan kehadiran Anda.</p></div>
  </section>

  <!-- WISHES -->
  <section class="wishes-sec" id="wishes">
    <p class="s-eyebrow rev">Ucapan</p>
    <h2 class="s-title rev d1">Doa & <em>Ucapan</em></h2>
    <div class="ornline rev d2"><span>✦</span></div>
    <div class="wishes-list" id="wishes-list">
      <div class="wish-card rev d3"><p class="wish-name">Ahmad Farid</p><p class="wish-attend">Hadir · 2 tamu</p><p class="wish-msg">Barakallahu lakuma wa baraka 'alaikuma. Semoga menjadi keluarga sakinah, mawaddah, warahmah.</p><p class="wish-time">Baru saja</p></div>
      <div class="wish-card rev d4"><p class="wish-name">Siti Aisyah</p><p class="wish-attend">Hadir · 1 tamu</p><p class="wish-msg">Selamat menempuh hidup baru! Semoga penuh berkah dan kebahagiaan. Aamiin 💕</p><p class="wish-time">2 menit lalu</p></div>
    </div>
  </section>

  <!-- GIFT -->
  <section class="gift-sec" id="gift">
    <p class="s-eyebrow rev">Wedding Gift</p>
    <h2 class="s-title rev d1">Kirim <em>Hadiah</em></h2>
    <div class="ornline rev d2"><span>✦</span></div>
    <p class="sec-intro rev d2">Doa restu Anda adalah hadiah yang paling berharga. Namun jika ingin memberikan tanda kasih:</p>
    <div class="gift-card rev-s d3">
      <p class="gift-bank">Bank Mandiri</p>
      <p class="gift-name">Reineta Dian Kusumawati</p>
      <p class="gift-acc">1234 5678 90</p>
      <button class="btn-copy" onclick="copyAcc('1234567890')"><span>Salin Nomor Rekening</span></button>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <img src="assets/img/wayang.png" alt="" class="footer-wayang" aria-hidden="true">
    <p class="footer-names rev">Azki & Rein</p>
    <p class="footer-date rev d1">Sabtu, 28 November 2026</p>
    <div class="ornline ornline-dk rev d2"><span>✦</span></div>
    <p class="footer-msg rev d3">Merupakan suatu kebahagiaan dan kehormatan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu.</p>
    <p class="footer-made rev d4">Made with ♥ · 2026</p>
  </footer>

</main>

<nav class="f-nav" id="fnav" style="display:none" aria-label="Navigasi halaman">
  <a class="f-nav-btn" href="#home"      title="Home">🏠</a>
  <a class="f-nav-btn" href="#couple"    title="Mempelai">💑</a>
  <a class="f-nav-btn" href="#event"     title="Acara">📅</a>
  <a class="f-nav-btn" href="#rsvp"      title="RSVP">✉</a>
  <a class="f-nav-btn" href="#gift"      title="Gift">🎁</a>
</nav>

<script>
// ── Guest name ──
(function(){
  const p=new URLSearchParams(location.search);
  const g=p.get('untuk')||p.get('to')||'';
  if(g)document.getElementById('cover-guest-name').textContent=decodeURIComponent(g);
})();

// ── Apps Script endpoint ──
const SCRIPT_URL='https://script.google.com/macros/s/AKfycbzy9tiym46a0FFCV6M3iFYU9GoGKdXceIuwHTr9LygUBg_DYIdlRW7lnxpfyDThcl9NMw/exec';

// ── Open invitation ──
function openInvitation(){
  document.getElementById('cover').classList.add('hidden');
  const main=document.getElementById('main');
  main.classList.add('visible');
  document.getElementById('fnav').style.display='flex';
  setTimeout(initReveal,420);
  startCountdown();
  const bgm=document.getElementById('bgm');
  bgm.volume=.35;
  bgm.play().catch(()=>{});
  document.getElementById('mp').classList.add('vis');
  document.getElementById('disc').classList.add('spin');
  initParticles();
}

// ── Scroll reveal ──
function initReveal(){
  const els=document.querySelectorAll('.rev,.rev-l,.rev-r,.rev-s');
  const io=new IntersectionObserver(entries=>{
    entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('on');io.unobserve(e.target)}});
  },{threshold:.07,rootMargin:'0px 0px -30px 0px'});
  els.forEach(el=>io.observe(el));
}

// ── Countdown ──
function startCountdown(){
  const tgt=new Date('2026-11-28T08:00:00+07:00').getTime();
  function tick(){
    const d=Math.max(0,tgt-Date.now());
    setNum('cd-days', Math.floor(d/864e5));
    setNum('cd-hours',Math.floor((d%864e5)/36e5));
    setNum('cd-mins', Math.floor((d%36e5)/6e4));
    setNum('cd-secs', Math.floor((d%6e4)/1e3));
  }
  tick();setInterval(tick,1000);
}
function setNum(id,v){
  const el=document.getElementById(id),s=String(v).padStart(2,'0');
  if(el.textContent!==s){
    el.style.transform='translateY(-4px)';el.style.opacity='.4';
    setTimeout(()=>{el.textContent=s;el.style.transform='';el.style.opacity=''},170);
  }
}

// ── RSVP ──
let attendVal='y';
function setAttend(v){
  attendVal=v;
  document.getElementById('opt-y').classList.toggle('sel',v==='y');
  document.getElementById('opt-n').classList.toggle('sel',v==='n');
  document.getElementById('jml-grp').style.display=v==='y'?'block':'none';
}
async function submitRSVP(){
  const nameEl=document.getElementById('rn');
  const name=nameEl.value.trim();
  if(!name){nameEl.style.borderColor='var(--marun)';nameEl.focus();setTimeout(()=>nameEl.style.borderColor='',2200);return}
  const count=attendVal==='y'?(document.getElementById('rcount').value||1):0;
  const msg=document.getElementById('rmsg').value.trim();
  const btn=document.getElementById('submit-btn');
  btn.classList.add('loading');
  btn.querySelector('span').textContent='Mengirim…';
  const payload={name,attend:attendVal==='y'?'Hadir':'Tidak Hadir',count,message:msg,timestamp:new Date().toLocaleString('id-ID',{timeZone:'Asia/Jakarta'})};
  try{await fetch(SCRIPT_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})}
  catch(e){console.warn('RSVP:',e)}
  if(msg){
    const c=document.createElement('div');c.className='wish-card';c.style.animation='rsvpIn .6s cubic-bezier(.215,.61,.355,1)';
    c.innerHTML=`<p class="wish-name">${esc(name)}</p><p class="wish-attend">${attendVal==='y'?`Hadir · ${count} tamu`:'Tidak Hadir'}</p><p class="wish-msg">${esc(msg)}</p><p class="wish-time">Baru saja</p>`;
    document.getElementById('wishes-list').prepend(c);
  }
  document.querySelector('.rsvp-form').style.display='none';
  document.getElementById('rsvp-success').style.display='block';
}
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}

// ── Music ──
function toggleMusic(){
  const b=document.getElementById('bgm'),d=document.getElementById('disc');
  if(b.paused){b.play();d.classList.add('spin')}else{b.pause();d.classList.remove('spin')}
}

// ── Copy ──
function copyAcc(n){
  if(navigator.clipboard)navigator.clipboard.writeText(n).then(toast).catch(()=>fbCopy(n));
  else fbCopy(n);
}
function fbCopy(n){const t=document.createElement('textarea');t.value=n;document.body.appendChild(t);t.select();document.execCommand('copy');document.body.removeChild(t);toast()}
function toast(){const t=document.getElementById('copyToast');t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2500)}

// ── Particles ──
const CV=document.getElementById('pc'),CX=CV.getContext('2d');
let pts=[],ptOn=false;
function rcv(){CV.width=innerWidth;CV.height=innerHeight}
addEventListener('resize',rcv);rcv();
class P{
  constructor(){this.reset()}
  reset(){this.x=Math.random()*CV.width;this.y=CV.height+8;this.r=Math.random()*2+.6;this.vy=-(Math.random()*.55+.18);this.vx=(Math.random()-.5)*.35;this.op=Math.random()*.38+.1;this.fade=Math.random()*.0018+.0007;this.w=Math.random()*Math.PI*2;this.ws=Math.random()*.014+.007}
  step(){this.y+=this.vy;this.w+=this.ws;this.x+=this.vx+Math.sin(this.w)*.22;this.op-=this.fade;if(this.op<=0||this.y<-8)this.reset()}
  draw(){CX.beginPath();CX.arc(this.x,this.y,this.r,0,Math.PI*2);CX.fillStyle=`rgba(184,150,62,${this.op})`;CX.fill();CX.beginPath();CX.arc(this.x,this.y,this.r*2.2,0,Math.PI*2);CX.fillStyle=`rgba(184,150,62,${this.op*.1})`;CX.fill()}
}
function initParticles(){
  if(ptOn)return;
  // fewer particles on mobile for performance
  const n=Math.min(innerWidth<480?22:50,Math.floor(innerWidth/18));
  pts=[];for(let i=0;i<n;i++){const p=new P();p.y=Math.random()*CV.height;pts.push(p)}
  ptOn=true;animP();
}
function animP(){if(!ptOn)return;CX.clearRect(0,0,CV.width,CV.height);pts.forEach(p=>{p.step();p.draw()});requestAnimationFrame(animP)}
document.addEventListener('visibilitychange',()=>{ptOn=!document.hidden;if(ptOn)animP()});
</script>
</body>
</html>